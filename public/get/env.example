# Biryar's settings. Save this file as .env beside docker-compose.yml.
# Both the API and the worker read it.

# Required. Seals every Amazon credential Biryar stores. Make one with:
#
#   docker run --rm ghcr.io/ciyalabs/biryar python -c \
#     "from biryar.crypto import Keyring; print('v1:' + Keyring.generate_key())"
#
# Keep a copy somewhere that is not this machine. Losing it means
# connecting Amazon again; anyone who has it can read what it sealed.
#
# To change it later, put the new key first and keep the old one:
#   BIRYAR_SECRET_KEY=v2:<new>,v1:<old>
BIRYAR_SECRET_KEY=

# Which Biryar to run. "latest" follows releases; a number such as 0.1.0
# stays put until you change it.
BIRYAR_VERSION=latest

# Where the interface answers: http://localhost:8000
BIRYAR_PORT=8000

# The two database passwords. Fine as they are on a machine only you use;
# change them before the first start if other people can reach it.
POSTGRES_PASSWORD=biryar
BIRYAR_APP_DB_PASSWORD=biryar_app

# Seconds between two requests to one shop while scanning. Politeness
# toward the shop, and what decides how long a scan takes.
BIRYAR_SOURCING_REQUEST_DELAY_SECONDS=3

# -- Amazon -------------------------------------------------------------------
# From your own application in the Solution Provider Portal: see
# https://biryar.ciyalabs.com/setup/sp-api/
#
# Both are needed to connect an account. The token you paste into Biryar is
# exchanged for a one-hour access token before every read, and Amazon checks
# that exchange against the application. Without them Amazon answers
# `invalid_client`, which looks exactly like a revoked authorisation.
BIRYAR_LWA_CLIENT_ID=
BIRYAR_LWA_CLIENT_SECRET=

# Only for running Biryar for other sellers through Amazon's consent page.
# Leave empty on your own install; a private application has no such page.
BIRYAR_AMAZON_APPLICATION_ID=
BIRYAR_AMAZON_REDIRECT_URI=
BIRYAR_AMAZON_APPLICATION_IS_DRAFT=true
