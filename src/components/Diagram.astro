---
/**
 * A drawing from src/diagrams, placed in the page as inline SVG.
 *
 * Inline rather than an <img> because a drawing in an <img> cannot see the
 * page's theme: it would stay dark on a light page, or follow the system
 * setting while the reader had chosen the other one with the switch. Inline,
 * it is written against the roles in biryar.css and follows the switch.
 *
 * The file's own <style> is dropped on the way in. It is there so the file
 * also reads properly when opened by itself; in the page, biryar.css says
 * what the roles are.
 */
interface Props {
  name: string;
  caption?: string;
  narrow?: boolean;
  /** Drawn on a wider canvas, for the full-width landing page. */
  wide?: boolean;
}

const files = import.meta.glob<string>('../diagrams/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const { name, caption, narrow = false, wide = false } = Astro.props;
const source = files[`../diagrams/${name}.svg`];
if (!source) throw new Error(`No drawing called ${name} in src/diagrams.`);
const svg = source
  .replace(/<\?xml[^>]*\?>/, '')
  .replace(/<style[\s\S]*?<\/style>/g, '')
  .trim();
---

<figure class:list={['diagram', 'not-content', { narrow, wide }]}>
  <Fragment set:html={svg} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
